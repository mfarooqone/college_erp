<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <template id="report_invoice_document"
      inherit_id="account.report_invoice_document"
      primary="True">

      <xpath expr="//t[@t-call='web.external_layout']" position="replace">
         <t t-call="web.html_container">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <t t-set="company" t-value="o.company_id" />
            <t t-set="has_bg"
               t-value="company.layout_background == 'Custom' and company.layout_background_image" />
            <t t-set="bg_overlay"
               t-value="has_bg and ('linear-gradient(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.9)), url(' + image_data_uri(company.layout_background_image) + ')') or ''" />
            <t t-set="section_bg_style"
               t-value="has_bg and ('background-image: ' + bg_overlay + '; background-size: cover; background-position: center top; background-repeat: no-repeat;') or ''" />

            <div class="article o_althuraya_invoice">

               <!-- 1) White top band — no bg image -->
               <div class="o_inv_header_white_top"/>

               <!-- 2) Bg image layer (body + area behind header sheet) -->
               <div class="o_inv_bg_section" t-att-style="section_bg_style">

                  <!-- 3) White sheet stacked ON bg — logo + letterhead only -->
                  <div class="o_inv_header_white_sheet">
                     <div class="row o_inv_header_row align-items-stretch">
                        <div class="col-5 o_inv_header_left">
                           <img t-if="company.logo"
                              class="o_inv_company_logo"
                              t-att-src="image_data_uri(company.logo)"
                              alt="Company Logo" />
                        </div>
                        <div class="col-7 o_inv_header_right">
                           <img class="o_inv_letter_head"
                              t-att-src="'/college_erp/static/letter_head.png'"
                              alt="Letterhead" />
                        </div>
                     </div>
                  </div>

                  <!-- 4) Invoice content — sits on bg image directly -->
                  <div class="o_inv_body_content">

                     <div class="o_inv_title">
                        <t t-if="proforma">Pro-forma Invoice</t>
                        <t t-else="">Tax Invoice</t>
                     </div>

                     <div class="row o_to_from_box">
                        <div class="col-6">
                           <strong>To</strong>
                           <div t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}' />
                        </div>
                        <div class="col-6">
                           <strong>From</strong>
                           <div t-field="o.company_id.partner_id"
                              t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}' />
                           <div t-if="o.company_id.vat" class="o_trn_line">
                              <strong class="o_trn_label">TRN:</strong>
                              <span class="o_trn_value" t-field="o.company_id.vat" />
                           </div>
                        </div>
                     </div>

                     <div class="o_inv_number_meta_block mb-3">
                        <div class="o_inv_number" t-if="o.name and o.name != '/'">
                           <t t-if="proforma">Pro-forma </t>
                           <span t-field="o.name" />
                        </div>
                        <div class="o_inv_meta_box">
                           <table class="o_inv_meta_table w-100">
                              <tr>
                                 <td class="o_meta_cell">
                                    <div class="o_meta_label">Invoice Date</div>
                                    <div class="o_meta_value" t-field="o.invoice_date" />
                                 </td>
                                 <td class="o_meta_cell">
                                    <div class="o_meta_label">Due Date</div>
                                    <div class="o_meta_value" t-field="o.invoice_date_due" />
                                 </td>
                              </tr>
                           </table>
                        </div>
                     </div>

                     <table class="table table-sm o_inv_lines mb-3">
                        <thead>
                           <tr>
                              <th class="text-center" style="width:4%;">SR.</th>
                              <th class="text-center" style="width:8%;">PLATE #</th>
                              <th class="text-start" style="width:28%;">DESCRIPTION</th>
                              <th class="text-start" style="width:14%;">PRODUCT / SERVICE</th>
                              <th class="text-center" style="width:10%;">START DATE</th>
                              <th class="text-center" style="width:10%;">END DATE</th>
                              <th class="text-end" style="width:10%;">UNIT PRICE</th>
                           </tr>
                        </thead>
                        <tbody>
                           <t t-set="lines_to_report"
                              t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product').sorted(key=lambda l: l.sequence)" />
                           <tr t-foreach="lines_to_report" t-as="line">
                              <td class="text-center">
                                 <span t-out="line.sr_no" />
                              </td>
                              <td class="text-center">
                                 <span t-field="line.plate_no" />
                              </td>
                              <td>
                                 <t t-if="line.chassis_no">
                                    <span t-field="line.chassis_no" />
                                    <br />
                                 </t>
                                 <t t-if="line.car_model">
                                    <span t-field="line.car_model" />
                                    <br />
                                 </t>
                                 <span t-if="line.name" t-field="line.name"
                                    t-options="{'widget': 'text'}" />
                              </td>
                              <td>
                                 <span t-field="line.product_id" />
                              </td>
                              <td class="text-center">
                                 <span t-field="line.service_start_date" />
                              </td>
                              <td class="text-center">
                                 <span t-field="line.service_end_date" />
                              </td>
                              <td class="text-end">
                                 <span t-field="line.price_unit"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                              </td>
                           </tr>
                        </tbody>
                     </table>

                     <t t-set="inv_taxes"
                        t-value="o.invoice_line_ids.mapped('tax_ids').filtered(lambda t: t.amount_type == 'percent')" />
                     <t t-set="invoice_bank"
                        t-value="o.partner_bank_id or o.company_id.partner_id.bank_ids[:1]" />
                     <div class="row o_bottom_section">
                        <div class="col-7">
                           <div t-if="o.payment_reference or o.name" class="o_payment_communication">
                              <strong>Payment Communication:</strong>
                              <span class="fw-bold" t-out="o.payment_reference or o.name" />
                           </div>
                           <div class="o_payment_account" t-if="invoice_bank">
                              <strong>on this account:</strong>
                              <span class="o_bank_account_number fw-bold">
                                 <span t-out="invoice_bank.acc_number" />
                                 <t t-if="invoice_bank.bank_id"> - <span
                                       t-field="invoice_bank.bank_id.name" />
                                 </t>
                              </span>
                           </div>
                        </div>
                        <div class="col-5">
                           <table class="table table-sm o_totals_table w-100">
                              <tr>
                                 <td>Untaxed Amount</td>
                                 <td class="text-end">
                                    <span t-field="o.amount_untaxed"
                                       t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                 </td>
                              </tr>
                              <tr>
                                 <td> VAT <t t-if="inv_taxes"
                                       t-out="' ' + str(int(inv_taxes[0].amount)) + '%'" />
                                                <t
                                       t-else=""> 0%</t>
                                 </td>
                                 <td class="text-end">
                                    <span t-field="o.amount_tax"
                                       t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                 </td>
                              </tr>
                              <tr class="o_total_row">
                                 <td>Total</td>
                                 <td class="text-end">
                                    <span t-field="o.amount_total"
                                       t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                 </td>
                              </tr>
                           </table>
                        </div>
                     </div>

                  </div>

               </div>

               <!-- 3) White footer sheet -->
               <div class="o_inv_footer_sheet" t-if="not is_html_empty(company.report_footer)">
                  <div class="o_inv_footer_content" t-field="company.report_footer" />
               </div>

            </div>
         </t>
      </xpath>

   </template>

   <template id="report_invoice" inherit_id="account.report_invoice">
      <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
         <t t-elif="o._get_name_invoice_report() == 'college_erp.report_invoice_document'"
            t-call="college_erp.report_invoice_document"
            t-lang="lang" />
      </xpath>
   </template>

</odoo>