<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_college_students_list" model="ir.ui.view">
      <field name="name">college.students.list</field>
      <field name="model">college.students</field>
      <field name="arch" type="xml">
         <list>
            <field name="admission_number" />
            <field name="name" />
            <field name="gender" />
            <field name="email" />
            <field name="phone" />
            <field name="admission_date" />
         </list>
      </field>
   </record>

   <record id="view_college_students_form" model="ir.ui.view">
      <field name="name">college.students.form</field>
      <field name="model">college.students</field>
      <field name="arch" type="xml">
         <form>
            <sheet>
               <group>
                  <group>
                     <field name="name" />
                     <field name="admission_number" />
                     <field name="admission_date" />
                     <field name="gender" />
                  </group>
                  <group>
                     <field name="email" />
                     <field name="phone" />
                     <field name="age" />
                  </group>
               </group>
               <group>
                  <field name="address" />
               </group>
            </sheet>
         </form>
      </field>
   </record>

   <record id="action_college_students" model="ir.actions.act_window">
      <field name="name">Students</field>
      <field name="res_model">college.students</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">
            Create a new student
         </p>
      </field>
   </record>
</odoo>