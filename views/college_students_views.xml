<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_college_students_list" model="ir.ui.view">
      <field name="name">college.students.list</field>
      <field name="model">college.students</field>
      <field name="arch" type="xml">
         <list>
            <field name="admission_number" />
            <field name="name" />
            <field name="program" optional="show" />
            <field name="gender" />
            <field name="email" />
            <field name="phone" />
            <field name="admission_date" />
         </list>
      </field>
   </record>

   <record id="view_college_students_form" model="ir.ui.view">
      <field name="name">college.students.form</field>
      <field name="model">college.students</field>
      <field name="arch" type="xml">
         <form>
            <sheet>
               <field name="image_1920" widget="image" class="oe_avatar"
                  options="{'preview_image': 'image_128'}" />
               <div class="oe_title">
                  <label for="name" />
                  <h1>
                     <field name="name" placeholder="Student name" />
                  </h1>
                  <h3>
                     <field name="admission_number" placeholder="Admission number" />
                  </h3>
               </div>
               <group>
                  <group>
                     <field name="admission_date" />
                     <field name="gender" />
                     <field name="age" />
                  </group>
               </group>
               <notebook>
                  <page string="Personal Information" name="personal">
                     <group>
                        <group string="Contact">
                           <field name="email" widget="email" />
                           <field name="phone" widget="phone" />
                        </group>
                     </group>
                  </page>
                  <page string="Admission" name="admission">
                     <group string="Admission Details">
                        <field name="admission_number" />
                        <field name="admission_date" />
                     </group>
                  </page>
                  <page string="Address" name="address">
                     <group string="Address">
                        <field name="communication_address" placeholder="Communication address" />
                        <field name="same_as_communication" widget="boolean_toggle" />
                        <field name="permanent_address"
                           invisible="same_as_communication"
                           placeholder="Permanent address" />
                     </group>
                  </page>
                  <page string="Academic" name="academic">
                     <group>
                        <group string="Program Details">
                           <field name="program" />
                           <field name="batch" />
                           <field name="semester" />
                        </group>
                     </group>
                  </page>
                  <page string="Guardian" name="guardian">
                     <group>
                        <group string="Guardian / Parent">
                           <field name="guardian_name" />
                           <field name="guardian_relation" />
                           <field name="guardian_phone" widget="phone" />
                           <field name="guardian_email" widget="email" />
                        </group>
                     </group>
                  </page>
                  <page string="Notes" name="notes">
                     <field name="notes" placeholder="Internal remarks, documents pending, etc." />
                  </page>
               </notebook>
            </sheet>
         </form>
      </field>
   </record>

   <record id="action_college_students" model="ir.actions.act_window">
      <field name="name">Students</field>
      <field name="res_model">college.students</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">
            Create a new student
         </p>
      </field>
   </record>

   <record id="action_college_admission" model="ir.actions.act_window">
      <field name="name">Admission</field>
      <field name="res_model">college.students</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
         <p class="o_view_nocontent_smiling_face">
            Register a new admission
         </p>
      </field>
   </record>
</odoo>
